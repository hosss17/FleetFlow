# Stage 1: Build Angular
FROM node:22-alpine AS builder
WORKDIR /build
COPY front-workspace/package.json front-workspace/package-lock.json ./
RUN npm install
COPY front-workspace/ .
RUN npm run build

# Stage 2: Serve with Nginx
FROM nginx:alpine
COPY --from=builder /build/dist/attijari-workspace /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
